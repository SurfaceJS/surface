{
    "all": false,
    "branches": 90,
    "exclude":
    [
        "**/packages/*/index.js",
        "**/node_modules",
        "**/tests",
        "**/test-suite/internal/assert.js"
    ],
    "extension": [".js"],
    "functions": 90,
    "include": ["packages/**/*.js"],
    "lines": 90,
    "reporter":
    [
        "text-summary",
        "lcov"
    ],
    "sourceMap": true,
    "statements": 90
}
